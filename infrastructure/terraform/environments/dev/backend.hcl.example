# Copy to backend.hcl (git-ignored) or pass the same keys from CI variables.
# Any S3-compatible, private, versioned, encrypted bucket. Credentials come from
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, never from this file.
bucket       = "kunde-tfstate"
key          = "dev/terraform.tfstate"
region       = "auto"
use_lockfile = true # native lock; verify it really blocks (docs/infrastructure/terraform-dev-render-neon.md)
encrypt      = true
# Non-AWS S3-compatible services (e.g. Cloudflare R2):
# endpoints = { s3 = "https://<account>.r2.cloudflarestorage.com" }
# use_path_style              = true
# skip_credentials_validation = true
# skip_requesting_account_id  = true
# skip_metadata_api_check     = true
# skip_region_validation      = true
# skip_s3_checksum            = true
